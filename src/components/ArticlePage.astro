---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from './PostCard.astro';
import ArticleVideo from './ArticleVideo.astro';
import { getPosts, readingTime, postSlug, postLanguage, type Post } from '../lib/posts';
import { categories, dateLabel, site, url } from '../config';
interface Props { post: Post }
const { post } = Astro.props;
const slug = postSlug(post);
const { Content, headings } = await render(post);
const category = categories.find(c => c.id === post.data.category)!;
const toc = headings.filter(h => h.depth === 2 || h.depth === 3);
const others = (await getPosts(postLanguage(post))).filter(p => p.id !== post.id);
const related = [...others.filter(p => p.data.category === post.data.category || p.data.tags.some(t => post.data.tags.includes(t))), ...others].filter((p, i, all) => all.findIndex(item => item.id === p.id) === i).slice(0, 3);
const structured = { '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description, datePublished: post.data.publishedAt.toISOString(), dateModified: (post.data.updatedAt || post.data.publishedAt).toISOString(), author: { '@type': 'Person', name: site.author }, mainEntityOfPage: new URL(url(`blog/${slug}/`), Astro.site || Astro.url.origin).href };
---
<Layout title={post.data.title} description={post.data.description} image={post.data.cover ? url(post.data.cover) : undefined} article>
  <script type="application/ld+json" set:html={JSON.stringify(structured).replace(/</g, '\\u003c')} />
  <div class="container"><header class="page-head article-head"><div class="breadcrumb"><a href={url()}>首页</a><span>/</span><a href={url(`categories/${category.id}/`)}>{category.name}</a><span>/</span><span>教程</span></div><a class:list={['category-label', category.color]} href={url(`categories/${category.id}/`)}>{category.name}</a><h1 data-verbatim>{post.data.title}</h1><p data-verbatim>{post.data.description}</p><div class="article-meta"><span>{site.author}</span><span>发布 <time datetime={post.data.publishedAt.toISOString()}>{dateLabel(post.data.publishedAt)}</time></span>{post.data.updatedAt && <span>更新 <time datetime={post.data.updatedAt.toISOString()}>{dateLabel(post.data.updatedAt)}</time></span>}<span>{readingTime(post)} 分钟阅读</span></div><div class="article-tags" data-verbatim>{post.data.tags.map(tag => <a href={url(`tags/${encodeURIComponent(tag)}/`)}># {tag}</a>)}</div></header>
  <div class="article-grid"><article class="article-body prose">{post.data.video && <ArticleVideo link={post.data.video} title={post.data.title} />}{post.data.cover && <img src={url(post.data.cover)} alt={post.data.title} data-verbatim width="800" height="450" />}<div data-verbatim data-authored-content><Content /></div><p class="copy-status" role="status" aria-live="polite"></p></article>
  {toc.length > 0 && <details class="toc" open><summary>本文目录</summary><ul data-verbatim>{toc.map(h => <li class:list={{ sub: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details>}</div>
  {related.length > 0 && <section class="section"><div class="section-heading"><div><span class="eyebrow">KEEP EXPLORING</span><h2>接着读下去<span class="heading-dot">.</span></h2></div><a class="text-link" href={url('categories/')}>浏览分类 →</a></div><div class="post-grid">{related.map(p => <PostCard post={p} compact />)}</div></section>}</div>
</Layout>
<script>
  const messages = document.documentElement.lang === 'en' ? ['Copy code', 'Copied', 'Copy failed', 'Clipboard access was denied. Please select and copy the code manually.'] : document.documentElement.lang === 'zh-TW' ? ['複製程式碼', '已複製', '複製失敗', '瀏覽器不允許存取剪貼簿，請選取程式碼手動複製。'] : ['复制代码', '已复制', '复制失败', '浏览器不允许访问剪贴板，请选中代码手动复制。'];
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach(pre => {
    const wrapper = document.createElement('div'); wrapper.className = 'code-wrap'; pre.before(wrapper); wrapper.append(pre);
    const button = document.createElement('button'); button.className = 'copy-button'; button.textContent = messages[0]; button.type = 'button'; wrapper.append(button);
    button.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || pre.textContent || ''); button.textContent = messages[1]; }
      catch { button.textContent = messages[2]; const status = document.querySelector('.copy-status'); if (status) status.textContent = messages[3]; }
      window.setTimeout(() => { button.textContent = messages[0]; }, 2200);
    });
  });
  const toc = document.querySelector<HTMLDetailsElement>('.toc');
  if (toc && window.matchMedia('(max-width: 700px)').matches) toc.open = false;
</script>
