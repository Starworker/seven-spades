---
import { categories, dateLabel, url } from '../config';
import { readingTime, postSlug, type Post } from '../lib/posts';
interface Props { post: Post; compact?: boolean }
const { post, compact = false } = Astro.props;
const category = categories.find(c => c.id === post.data.category)!;
---
<article class:list={['post-card', { compact }]}>
  {!compact && <a class:list={['post-cover', category.color]} href={url(`blog/${postSlug(post)}/`)} tabindex="-1" aria-hidden="true">{post.data.cover ? <img src={url(post.data.cover)} alt="" width="800" height="450" loading="lazy" /> : <><span class="cover-grid"></span><span class="cover-icon">{category.icon}</span><span class="cover-label">{category.name}<small>SEVEN SPADES / GUIDE</small></span></>}</a>}
  <div class="post-card-body"><div class="post-meta"><a class:list={['category-label', category.color]} href={url(`categories/${category.id}/`)}>{category.name}</a><span>{readingTime(post)} 分钟阅读</span></div>
  <h3 data-verbatim><a href={url(`blog/${postSlug(post)}/`)}>{post.data.title}</a></h3><p data-verbatim>{post.data.description}</p>
  <div class="card-bottom"><time datetime={post.data.publishedAt.toISOString()}>{dateLabel(post.data.publishedAt)}</time><a href={url(`blog/${postSlug(post)}/`)} >阅读教程 <span aria-hidden="true">↗</span></a></div></div>
</article>

